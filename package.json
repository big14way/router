{
  "name": "hedera-smart-order-router",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/hardhat",
      "packages/nextjs",
      "packages/router-sdk"
    ]
  },
  "scripts": {
    "execute:plan": "tsx scripts/execute-plan.ts",
    "format": "yarn next:format && yarn hardhat:format && yarn sdk:format",
    "gate:check": "node scripts/gate-check.mjs",
    "gate:check:local": "node scripts/gate-check.mjs --local",
    "hardhat:account": "yarn workspace @sh/hardhat account",
    "hardhat:account:generate": "yarn workspace @sh/hardhat account:generate",
    "hardhat:account:import": "yarn workspace @sh/hardhat account:import",
    "hardhat:account:reveal-pk": "yarn workspace @sh/hardhat account:reveal-pk",
    "hardhat:chain": "yarn workspace @sh/hardhat chain",
    "hardhat:check-types": "yarn workspace @sh/hardhat check-types",
    "hardhat:clean": "yarn workspace @sh/hardhat clean",
    "hardhat:compile": "yarn workspace @sh/hardhat compile",
    "hardhat:deploy": "yarn workspace @sh/hardhat deploy",
    "hardhat:flatten": "yarn workspace @sh/hardhat flatten",
    "hardhat:fork": "yarn workspace @sh/hardhat fork",
    "hardhat:format": "yarn workspace @sh/hardhat format",
    "hardhat:lint": "yarn workspace @sh/hardhat lint",
    "hardhat:lint-staged": "yarn workspace @sh/hardhat lint-staged",
    "hardhat:test": "yarn workspace @sh/hardhat test",
    "hardhat:verify": "yarn workspace @sh/hardhat verify:contract",
    "harness:doctor": "hedera-harness doctor .harness/spec.yaml",
    "harness:run": "hedera-harness run .harness/spec.yaml",
    "harness:validate": "hedera-harness validate .harness/spec.yaml",
    "lint": "yarn next:lint && yarn hardhat:lint && yarn sdk:lint",
    "lint-staged": "lint-staged",
    "next:build": "yarn workspace @sh/nextjs build",
    "next:check-types": "yarn workspace @sh/nextjs check-types",
    "next:dev": "yarn workspace @sh/nextjs dev",
    "next:format": "yarn workspace @sh/nextjs format",
    "next:lint": "yarn workspace @sh/nextjs lint",
    "next:serve": "yarn workspace @sh/nextjs serve",
    "next:start": "yarn workspace @sh/nextjs start",
    "postinstall": "husky",
    "precommit": "lint-staged",
    "scripts:check-types": "tsc -p scripts/tsconfig.json",
    "scripts:format": "yarn workspace @sh/router-sdk prettier --write ../../scripts/*.ts ../../scripts/*.mjs",
    "sdk:build": "yarn workspace @sh/router-sdk build",
    "sdk:check-types": "yarn workspace @sh/router-sdk check-types",
    "sdk:format": "yarn workspace @sh/router-sdk format",
    "sdk:lint": "yarn workspace @sh/router-sdk lint",
    "sdk:plan": "yarn workspace @sh/router-sdk plan",
    "sdk:quote": "yarn workspace @sh/router-sdk quote",
    "sdk:test": "yarn workspace @sh/router-sdk test",
    "sdk:test:coverage": "yarn workspace @sh/router-sdk test:coverage",
    "seed:testnet": "tsx scripts/seed-testnet.ts",
    "test": "yarn sdk:test && yarn hardhat:test",
    "topic:create": "tsx scripts/create-topic.ts",
    "v3:onboard": "tsx scripts/v3-onboard.ts",
    "v3:place-and-cancel": "tsx scripts/v3-place-and-cancel.ts"
  },
  "packageManager": "yarn@3.2.3",
  "devDependencies": {
    "@hiero-ledger/sdk": "^2.80.0",
    "@types/node": "^20.17.0",
    "dotenv": "~16.4.5",
    "hedera-harness": "1.2.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "viem": "2.39.0"
  },
  "engines": {
    "node": ">=20.18.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/big14way/router.git"
  }
}
